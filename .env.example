# Local development settings. Do not put real secrets in this file.

# App
APP_ENV=local
LOG_LEVEL=INFO

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=incendies_gironde_landes_2026

# Models
MODEL_NAME=

# Météo-France API
METEO_FRANCE_API_KEY=
METEO_FRANCE_API_BASE_URL=https://public-api.meteofrance.fr/public/DPMeteoForets/v1

# Airflow
AIRFLOW_UID=50000

# Ingestion
INGESTION_TIMEZONE=Europe/Paris
INGESTION_MAX_REQUESTS_PER_MINUTE=30
