# Local development settings. Do not put real secrets in this file.

# App
APP_ENV=local
LOG_LEVEL=INFO

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=incendies_gironde_landes_2026

# Models
MODEL_NAME=
RAG_RESPONSE_MODE=llm
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.6-flash
LLM_MAX_NEW_TOKENS=120
LLM_TEMPERATURE=0

# Cloud LLM API keys. Set only the key for the provider you use.
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web app
CHATBOT_API_URL=http://localhost:8001

# Météo-France API
# Used by Météo des forêts, vigilance, forecast, and observations APIs.
METEO_FRANCE_API_KEY=
METEO_FRANCE_API_BASE_URL=https://public-api.meteofrance.fr/public/DPMeteoForets/v1
METEO_FRANCE_VIGILANCE_API_BASE_URL=https://public-api.meteofrance.fr/public/DPVigilance/v1

# NASA FIRMS API
NASA_FIRMS_MAP_KEY=

# Georisques API
GEORISQUES_API_BASE_URL=https://www.georisques.gouv.fr/api/v1

# Airflow
AIRFLOW_UID=50000

# Ingestion
INGESTION_TIMEZONE=Europe/Paris
INGESTION_MAX_REQUESTS_PER_MINUTE=30
